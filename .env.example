PORT=4173
HOST=127.0.0.1

# Optional. Fill this before exposing the site publicly.
APP_ACCESS_CODE=

# Set to "local" for preview/demo, or "lark" to sync every submission to Feishu Base.
STORAGE_MODE=local

# Use "cli" locally, or "openapi" after deploying to a public cloud service.
LARK_SYNC_MODE=cli

# lark-cli identity used locally when LARK_SYNC_MODE=cli: user or bot.
LARK_AS=user

# Feishu app credentials used on cloud when LARK_SYNC_MODE=openapi.
LARK_APP_ID=
LARK_APP_SECRET=

# Feishu Base config. Fill these after creating the Base and tables.
LARK_BASE_TOKEN=
LARK_CHECKIN_TABLE_ID=
LARK_WEIGHT_TABLE_ID=

# Optional. If left blank, the server will look up the attachment field by name.
LARK_CHECKIN_PHOTO_FIELD_ID=

# Field names in Feishu Base. Defaults match the setup script.
LARK_FIELD_MEMBER=成员
LARK_FIELD_CHECKIN_DATE=打卡日期
LARK_FIELD_CHECKIN_TIME=打卡时间
LARK_FIELD_ACTIVITY=打卡形式
LARK_FIELD_DURATION=运动时长_分钟
LARK_FIELD_DISTANCE=运动距离_公里
LARK_FIELD_INTENSITY=强度
LARK_FIELD_NOTE=备注
LARK_FIELD_PHOTO=打卡照片

LARK_FIELD_MONTH=月份
LARK_FIELD_WEIGHT_PERIOD=记录类型
LARK_FIELD_WEIGHT_KG=体重_公斤
LARK_FIELD_WEIGHT_TIME=测量时间
